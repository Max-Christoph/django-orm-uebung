# OPTIONAL -- du brauchst diese Datei nicht.
#
# docker-compose.yml und config/settings.py bringen die Werte bereits als Default mit.
# Die Uebung laeuft ohne jede Konfiguration.
#
# Nur wenn du andere Zugangsdaten willst:
#     cp .env.example .env      und die Werte unten anpassen
#
# Achtung: PostgreSQL legt Benutzer und Passwort nur beim ERSTEN Start an. Aenderst du
# die Werte spaeter, muss das Daten-Volume neu gebaut werden:
#     docker compose down -v && docker compose up -d
#
# .env wird NICHT committet.

POSTGRES_DB=bibliothek
POSTGRES_USER=bibliothek
POSTGRES_PASSWORD=bibliothek

# Host-Port, auf dem PostgreSQL erreichbar ist (Container-intern bleibt es 5432).
# Aenderst du ihn hier, muss 'PORT' in config/settings.py mitgeaendert werden.
DB_PORT=5433
