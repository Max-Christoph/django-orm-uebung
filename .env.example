# Beispiel-Konfiguration fuer die Datenbank.
#
# Anlegen:  cp .env.example .env
#
# Die Werte sind nur fuer die lokale Uebung gedacht. .env wird NICHT committet.

POSTGRES_DB=bibliothek
POSTGRES_USER=bibliothek
POSTGRES_PASSWORD=bibliothek

# Host-Port, auf dem PostgreSQL erreichbar ist (Container-intern bleibt es 5432).
# Bewusst 5433, damit eine lokal installierte PostgreSQL auf 5432 nicht stoert.
DB_PORT=5433
